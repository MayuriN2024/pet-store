pipeline {
    agent { label 'slave' }

    environment {
        DOCKER_IMAGE   = "yourdockerhubusername/pet-store"
        DOCKER_TAG     = "${BUILD_NUMBER}"   // unique tag per build
        CLUSTER_NAME   = "pet-store-cluster"
        REGION         = "us-east-1"
        SONAR_URL      = "http://<sonarqube-server-ip>:9000"
        APP_URL        = ""   // filled after deploy
    }

    stages {

        // ─────────────────────────────────────
        // STAGE 1: Checkout
        // ─────────────────────────────────────
        stage('Checkout Code') {
            steps {
                echo '📥 Pulling latest code from GitHub...'
                checkout scm
            }
        }

        // ─────────────────────────────────────
        // STAGE 2: SAST - SonarQube
        // ─────────────────────────────────────
        stage('SAST - SonarQube Scan') {
            steps {
                echo '🔍 Running SAST with SonarQube...'
                withSonarQubeEnv('SonarQube') {
                    sh '''
                        sonar-scanner \
                          -Dsonar.projectKey=pet-store \
                          -Dsonar.projectName="Pet Store" \
                          -Dsonar.sources=. \
                          -Dsonar.host.url=$SONAR_URL
                    '''
                }
            }
        }

        // SonarQube Quality Gate - fails pipeline if code quality is bad
        stage('Quality Gate') {
            steps {
                echo '🚦 Checking SonarQube Quality Gate...'
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        // ─────────────────────────────────────
        // STAGE 3: SCA - Trivy Filesystem Scan
        // ─────────────────────────────────────
        stage('SCA - Trivy Filesystem Scan') {
            steps {
                echo '📦 Running SCA with Trivy (scanning files & dependencies)...'
                sh '''
                    trivy fs \
                      --severity HIGH,CRITICAL \
                      --exit-code 0 \
                      --format table \
                      -o trivy-fs-report.txt \
                      .

                    echo "──── Trivy Filesystem Report ────"
                    cat trivy-fs-report.txt
                '''
            }
        }

        // ─────────────────────────────────────
        // STAGE 4: Build Docker Image
        // ─────────────────────────────────────
        stage('Build Docker Image') {
            steps {
                echo '🐳 Building Docker image...'
                sh "docker build -t ${DOCKER_IMAGE}:${DOCKER_TAG} ."
                sh "docker tag ${DOCKER_IMAGE}:${DOCKER_TAG} ${DOCKER_IMAGE}:latest"
                echo '✅ Docker image built!'
            }
        }

        // ─────────────────────────────────────
        // STAGE 5: Container Scan - Trivy Image
        // ─────────────────────────────────────
        stage('Container Scan - Trivy Image') {
            steps {
                echo '🔒 Scanning Docker image with Trivy...'
                sh '''
                    trivy image \
                      --severity HIGH,CRITICAL \
                      --exit-code 0 \
                      --format table \
                      -o trivy-image-report.txt \
                      ''' + "${DOCKER_IMAGE}:${DOCKER_TAG}" + '''

                    echo "──── Trivy Image Report ────"
                    cat trivy-image-report.txt
                '''
            }
        }

        // ─────────────────────────────────────
        // STAGE 6: Push to Docker Hub
        // ─────────────────────────────────────
        stage('Push Docker Image') {
            steps {
                echo '📤 Pushing image to Docker Hub...'
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-creds',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh '''
                        echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin
                        docker push ''' + "${DOCKER_IMAGE}:${DOCKER_TAG}" + '''
                        docker push ''' + "${DOCKER_IMAGE}:latest" + '''
                        echo "✅ Image pushed!"
                    '''
                }
            }
        }

        // ─────────────────────────────────────
        // STAGE 7: Terraform - Create EKS
        // ─────────────────────────────────────
        stage('Terraform - Provision EKS') {
            steps {
                echo '🏗️ Provisioning EKS with Terraform...'
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-credentials'
                ]]) {
                    dir('terraform') {
                        sh '''
                            terraform init
                            terraform plan -out=tfplan
                            terraform apply -auto-approve tfplan
                            echo "✅ EKS Cluster provisioned!"
                        '''
                    }
                }
            }
        }

        // ─────────────────────────────────────
        // STAGE 8: Ansible - Configure Nodes
        // ─────────────────────────────────────
        stage('Ansible - Configure Nodes') {
            steps {
                echo '⚙️ Configuring nodes with Ansible...'
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-credentials'
                ]]) {
                    sh '''
                        ansible-playbook ansible/configure-nodes.yml
                        echo "✅ Nodes configured!"
                    '''
                }
            }
        }

        // ─────────────────────────────────────
        // STAGE 9: Helm - Deploy to Kubernetes
        // ─────────────────────────────────────
        stage('Helm - Deploy to EKS') {
            steps {
                echo '🚀 Deploying Pet Store with Helm...'
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-credentials'
                ]]) {
                    sh '''
                        aws eks update-kubeconfig \
                          --name $CLUSTER_NAME \
                          --region $REGION

                        # Deploy or upgrade with Helm
                        helm upgrade --install pet-store helm/pet-store \
                          --namespace pet-store \
                          --create-namespace \
                          --set image.tag=''' + "${DOCKER_TAG}" + ''' \
                          --wait

                        echo "✅ Pet Store deployed on EKS!"

                        # Get the public URL
                        echo "──────────────────────────────────"
                        echo "App URL:"
                        kubectl get svc pet-store-service -n pet-store \
                          -o jsonpath="{.status.loadBalancer.ingress[0].hostname}"
                        echo ""
                        echo "──────────────────────────────────"
                    '''
                }
            }
        }

        // ─────────────────────────────────────
        // STAGE 10: DAST - OWASP ZAP
        // ─────────────────────────────────────
        stage('DAST - OWASP ZAP Scan') {
            steps {
                echo '🕵️ Running DAST with OWASP ZAP...'
                script {
                    // Get the app URL first
                    def appUrl = sh(
                        script: """
                            kubectl get svc pet-store-service -n pet-store \
                              -o jsonpath="{.status.loadBalancer.ingress[0].hostname}"
                        """,
                        returnStdout: true
                    ).trim()

                    // Run OWASP ZAP baseline scan
                    sh """
                        docker run --rm \
                          -v \${WORKSPACE}:/zap/wrk \
                          ghcr.io/zaproxy/zaproxy:stable zap-baseline.py \
                          -t http://${appUrl} \
                          -r zap-report.html \
                          -I
                        echo "✅ DAST Scan complete!"
                    """
                }
            }
        }
    }

    // ─────────────────────────────────────
    // Archive Reports
    // ─────────────────────────────────────
    post {
        always {
            archiveArtifacts artifacts: '*.txt, *.html', allowEmptyArchive: true
            echo '📊 Security reports saved!'
        }
        success {
            echo '🎉 Pipeline SUCCESS! Pet Store is LIVE with full DevSecOps!'
        }
        failure {
            echo '❌ Pipeline FAILED! Check the stage logs above.'
        }
    }
}